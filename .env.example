# Copy to .env and adjust. Never commit real secrets.

VOICE_ATOM_PROVIDER=whisper_cpp
VOICE_ATOM_OUTPUT_DIR=./runs
VOICE_ATOM_DEFAULT_SECONDS=8

VOICE_ATOM_WHISPER_CPP_BIN=./bin/whisper-cli.exe
# Multilingual model (supports zh). ~190MB quantized small:
VOICE_ATOM_WHISPER_MODEL=./models/ggml-small-q5_1.bin
VOICE_ATOM_LANGUAGE=zh
VOICE_ATOM_THREADS=4
# Optional extra CLI args as one string, e.g. --no-prints (depends on your whisper build)
# VOICE_ATOM_WHISPER_EXTRA_ARGS=

VOICE_ATOM_HOST=127.0.0.1
VOICE_ATOM_PORT=17860
# Set to 1 only if you intentionally bind 0.0.0.0 / ::
# VOICE_ATOM_ALLOW_PUBLIC_BIND=0

# Doubao / Volcengine ASR (upload mode). Only used when VOICE_ATOM_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_ASR_MODEL=
# HTTPS endpoint that accepts audio upload (multipart); must match your Volcengine product docs
DOUBAO_ASR_UPLOAD_URL=
