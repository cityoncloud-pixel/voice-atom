# --- Environment & secrets ---
.env
.env.*
!.env.example
.envrc
.direnv/

# Keys & certificates
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pem.enc

# Cloud / provider credential blobs (common filenames)
credentials.json
**/credentials.json
service-account*.json
*-service-account*.json
google-application-credentials.json
.aws/credentials
.azure/

# Local-only overrides
local.settings.json
secrets.json
.secrets/

# --- Logs & generated noise ---
*.log
logs/

# --- OS & editor junk ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- Dependencies & build (future-proof) ---
node_modules/
dist/
build/
out/
.next/
.nuxt/
.turbo/
coverage/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# IDE (optional local; keep team-shared rules if you commit them)
.idea/
*.iml

# whisper.cpp local installs (large / platform-specific)
models/*.bin
bin/*.exe
bin/*.dll

# Local recordings under runs/ (keep runs/.gitkeep only)
runs/*
!runs/.gitkeep
